{
  "name": "nextjs-fullstack-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate:agents-md": "bun run scripts/validate-agents-md.ts",
    "knip": "knip --max-issues 60",
    "jscpd": "jscpd --config .jscpd.json",
    "depcruise": "dependency-cruiser src/",
    "check:todos": "bun run scripts/check-todos.mjs",
    "check:todos:strict": "bun run scripts/check-todos.mjs --require-ticket",
    "docs:generate": "bun run scripts/generate-docs.mjs && node_modules/.bin/prettier --write docs/generated/",
    "docs:check": "bun run docs:generate && git diff --exit-code docs/generated/",
    "analyze:bundle": "ANALYZE=true bun run build",
    "prepare": "husky",
    "postinstall": "node scripts/patch-eslint-plugin-react.mjs",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:push": "bun --env-file=.env.local drizzle-kit push",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:studio": "bun --env-file=.env.local drizzle-kit studio",
    "db:check": "bun --env-file=.env.local drizzle-kit check",
    "db:drop": "bun --env-file=.env.local drizzle-kit drop",
    "seed:holidays": "bun --env-file=.env.local run scripts/seed-holidays.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.6.28",
    "@hookform/resolvers": "5.8.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@neondatabase/serverless": "1.1.0",
    "@react-pdf/renderer": "4.6.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.1.2",
    "@types/papaparse": "5.5.2",
    "axios": "1.19.0",
    "better-auth": "1.6.28",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "drizzle-orm": "0.45.2",
    "little-date": "1.2.1",
    "next": "16.3.1",
    "next-themes": "0.4.6",
    "papaparse": "5.6.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "shadcn": "4.18.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@next/bundle-analyzer": "16.3.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jscpd": "5.0.15",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
